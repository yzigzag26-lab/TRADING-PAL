# Baymax environment template
# Copy backend values into apps/api/.env for local development.
# Never commit real .env files or paste credentials into GitHub, chat, or source code.

# ---------------------------------------------------------------------------
# BACKEND — apps/api/.env
# These values are server-side. Never prefix secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://baymax-nu.vercel.app

# Private single-owner authentication
BAYMAX_PASSWORD_HASH=
BAYMAX_SESSION_SECRET=

# Supabase PostgreSQL runtime connection
# Use the dedicated baymax_runtime login; never the database owner credential.
DATABASE_URL=

# Migration-only connection — private operator / secure CI migration runner ONLY.
# Never set MIGRATION_DATABASE_URL on the Render web service or Vercel.
MIGRATION_DATABASE_URL=

# Binance Spot public market data — Gate 3 defaults; not consumed until implemented.
# Public market-data-only endpoints do not require an API key or secret.
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision

# Groq AI provider — configure the API key on Render only for deployed AI responses.
# Never put the key in Vercel, frontend code, or source control.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Production clock health uses outbound NTP (UDP/123) to multiple sources.
# No clock-health secret or environment override is required.

# Supabase Storage — later phase; use a private bucket for chart uploads.
SUPABASE_CHARTS_BUCKET=baymax-chart-uploads
