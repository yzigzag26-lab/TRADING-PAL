# Baymax environment template
# Copy the relevant values into apps/web/.env.local (frontend) and apps/api/.env (backend).
# Never commit real .env files or paste real credentials into GitHub, chat, or source code.

# ---------------------------------------------------------------------------
# FRONTEND — apps/web/.env.local
# These NEXT_PUBLIC_ values are exposed to the browser. ONLY public values belong here.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# BACKEND — apps/api/.env
# These values are server-side. Never prefix secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://baymax-nu.vercel.app

# Supabase project configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Supabase project Auth JWKS endpoint; confirm against your project's Auth settings.
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# Optional: only configure if the approved backend database-access design uses direct PostgreSQL.
# Obtain the connection string from Supabase Dashboard > Project Settings > Database.
# Never use a browser-exposed database URL.
DATABASE_URL=

# Binance Spot API credentials — configure only on the backend.
# Create a dedicated key for Baymax with reading access only.
# Do NOT enable Spot/Margin trading, Futures, withdrawals, or transfers.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_RECV_WINDOW_MS=5000

# AI provider — later phase; leave empty until Groq integration is approved.
GROQ_API_KEY=
GROQ_VISION_MODEL=
GROQ_REASONING_MODEL=

# Supabase Storage — later phase; use a private bucket for chart uploads.
SUPABASE_CHARTS_BUCKET=baymax-chart-uploads
