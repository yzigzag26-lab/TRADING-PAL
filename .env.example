# Baymax environment template
# Copy relevant values into apps/web/.env.local (frontend) and apps/api/.env (backend).
# Never commit real .env files or paste credentials into GitHub, chat, or source code.

# ---------------------------------------------------------------------------
# FRONTEND — apps/web/.env.local
# These NEXT_PUBLIC_ values are exposed to the browser. ONLY public values belong here.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# BACKEND — apps/api/.env
# These values are server-side. Never prefix secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://baymax-nu.vercel.app

# Current private owner-session configuration
BAYMAX_PASSWORD_HASH=
BAYMAX_SESSION_SECRET=

# Supabase/PostgreSQL configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
DATABASE_URL=
# Migration-only; private operator / approved GitHub environment only.
# Never set MIGRATION_DATABASE_URL on Render or Vercel.
MIGRATION_DATABASE_URL=

# Binance Spot public market data — Gate 3 defaults; not consumed until implemented.
# Public market-data-only endpoints do not require an API key or secret.
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision

# AI provider — later phase; leave empty until Groq integration is approved.
GROQ_API_KEY=
GROQ_VISION_MODEL=
GROQ_REASONING_MODEL=

# Supabase Storage — later phase; use a private bucket for chart uploads.
SUPABASE_CHARTS_BUCKET=baymax-chart-uploads
